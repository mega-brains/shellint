  "dependencies": {
    "hono": "^4.7.0",
    "@hono/node-server": "^1.14.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/ws": "^8.5.14",
    "@types/node": "^22.13.0",
    "tsx": "^4.19.0",
    "esbuild": "^0.25.0",
    "codemirror": "^6.0.1",
    "@codemirror/lang-javascript": "^6.2.2",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.36.2",
    "@codemirror/commands": "^6.8.0",
    "@codemirror/language": "^6.10.8"
  },
  "scripts": {
    "dev": "npm run build:web && node --import tsx server/index.ts",
