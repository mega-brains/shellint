{
  "name": "shelly-devroom",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Local playground for authoring Shelly Gen2 device scripts",
  "scripts": {
    "build:shelly": "node scripts/build-shelly.mjs",
    "build:web": "node scripts/gen-api-docs.mjs && node scripts/build-web.mjs --prod",
    "build:web:dev": "node scripts/gen-api-docs.mjs && node scripts/build-web.mjs",
    "build:static": "node scripts/build-static.mjs",
    "preview:static": "node scripts/preview-static.mjs",
    "build": "npm run build:shelly && npm run build:web",
    "dev": "npm run build:web:dev && node --import tsx server/index.ts",
    "deploy": "node --import tsx server/cli/cli-deploy.ts",
    "probe": "node --import tsx server/cli/cli-probe.ts",
    "profile": "node --import tsx server/cli/cli-profile.ts",
    "typecheck:shelly": "tsc -p tsconfig.shelly.json --noEmit",
    "typecheck:server": "tsc -p tsconfig.server.json",
    "typecheck:web": "tsc -p tsconfig.web.json",
    "typecheck": "npm run typecheck:shelly && npm run typecheck:server && npm run typecheck:web",
    "lint": "npm run typecheck",
    "bench": "node scripts/bench-minify.mjs",
    "check:lines": "node scripts/check-line-limit.mjs",
    "test": "node --import tsx scripts/test.mjs",
    "test:e2e": "playwright test -c e2e/playwright.config.ts",
    "beforeCommit": "npm run check:lines && npm run typecheck && npm run build && npm run build:static && npm run test && npm run test:e2e"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.0",
    "hono": "^4.7.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.8.0",
    "@codemirror/lang-javascript": "^6.2.2",
    "@codemirror/language": "^6.10.8",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.36.2",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.13.0",
    "@types/ws": "^8.5.14",
    "esbuild": "^0.25.0",
    "espruino": "^0.1.67",
    "playwright": "^1.62.1",
    "preact": "^10.29.8",
    "terser": "^5.49.2",
    "tsx": "^4.19.0",
    "typescript": "^5.9.2"
  }
}
