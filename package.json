{
  "name": "shellint",
  "version": "0.0.1",
  "license": "MIT",
  "private": true,
  "type": "module",
  "imports": {
    "#shellint/builder": {
      "txiki": "./server/build/txiki-builder-entry.ts",
      "default": "./server/build/node-builder-entry.ts"
    },
    "#shellint/runtime": {
      "txiki": "./server/runtime/txiki.ts",
      "static": "./web/static/runtime.ts",
      "default": "./server/runtime/node.ts"
    }
  },
  "description": "Local playground for authoring Shelly Gen2 device scripts",
  "scripts": {
    "build:shelly": "node scripts/ensure-main.mjs && node scripts/build-shelly.mjs",
    "build:shelly:fixture": "node scripts/build-fixture.mjs",
    "build:web": "node scripts/gen-api-docs.mjs && node scripts/build-web.mjs --prod",
    "build:web:dev": "node scripts/gen-api-docs.mjs && node scripts/build-web.mjs",
    "build:static": "node scripts/build-static.mjs",
    "vendor:txiki": "node scripts/vendor-txiki.mjs",
    "build:txiki": "npm run vendor:txiki && node scripts/build-txiki.mjs",
    "build:txiki:executable": "npm run build:txiki && node scripts/compile-txiki.mjs",
    "preview:static": "node scripts/preview-static.mjs",
    "build": "npm run oxlint && npm run build:shelly && npm run build:web",
    "build:gate": "npm run oxlint && npm run build:shelly:fixture && npm run build:web",
    "dev": "npm run build:web:dev && node --import tsx server/index.ts",
    "dev:txiki": "npm run build:web:dev && npm run build:txiki && node scripts/run-txiki.mjs server",
    "start:txiki": "node scripts/run-txiki.mjs server",
    "deploy": "node --import tsx server/cli/cli-deploy.ts",
    "probe": "node --import tsx server/cli/cli-probe.ts",
    "profile": "node --import tsx server/cli/cli-profile.ts",
    "deploy:txiki": "npm run build:txiki && node scripts/run-txiki.mjs deploy",
    "probe:txiki": "npm run build:txiki && node scripts/run-txiki.mjs probe",
    "profile:txiki": "npm run build:txiki && node scripts/run-txiki.mjs profile",
    "typecheck:shelly": "tsc -p tsconfig.shelly.fixture.json --noEmit",
    "typecheck:script": "node scripts/ensure-main.mjs && tsc -p tsconfig.shelly.script.json --noEmit",
    "typecheck:server": "tsc -p tsconfig.server.json",
    "typecheck:web": "tsc -p tsconfig.web.json",
    "typecheck:txiki": "tsc -p tsconfig.txiki.json",
    "typecheck": "npm run typecheck:shelly && npm run typecheck:server && npm run typecheck:web",
    "lint": "npm run typecheck",
    "oxlint": "oxlint server web scripts shared e2e",
    "bench": "node scripts/bench-minify.mjs",
    "check:lines": "node scripts/check-line-limit.mjs",
    "clean": "node scripts/clean.mjs",
    "test": "node --import tsx scripts/test.mjs",
    "test:e2e": "playwright test -c e2e/playwright.config.ts",
    "test:e2e:txiki": "playwright test -c e2e/playwright.txiki.config.ts",
    "test:e2e:lightpanda": "playwright test -c e2e/playwright.lightpanda.config.ts",
    "test:e2e:hybrid": "node scripts/e2e-hybrid.mjs",
    "install:lightpanda": "node scripts/install-lightpanda.mjs",
    "test:txiki": "npm run vendor:txiki && npm run typecheck:txiki && npm run build:web && node scripts/test-txiki-runtime.mjs",
    "beforeCommit": "npm run oxlint && npm run check:lines && npm run typecheck && npm run build:gate && npm run build:static && npm run test && npm run test:e2e && npm run test:e2e:txiki"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.8.0",
    "@codemirror/lang-javascript": "^6.2.2",
    "@codemirror/language": "^6.10.8",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.36.2",
    "@lezer/highlight": "^1.2.3",
    "@playwright/test": "^1.62.1",
    "@txikijs/types": "^26.6.0",
    "@types/node": "^22.13.0",
    "@types/ws": "^8.5.14",
    "esbuild": "^0.25.0",
    "espruino": "^0.1.67",
    "oxlint": "1.79.0",
    "playwright": "^1.62.1",
    "preact": "^10.29.8",
    "terser": "^5.49.2",
    "tsx": "^4.19.0",
    "typescript": "^5.9.2"
  }
}
