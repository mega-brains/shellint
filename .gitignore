.idea/
.DS_Store
# Agent working files — plans, findings, design handoffs. Local-only: they carry
# device addresses and pasted device code. The old `.claude/.*` pattern only
# ignored dotfiles *inside* the directory, which is how 49 of them got tracked.
.claude/
# The live editor buffer. Yours, never the repo's — it is what the UI edits and
# what `mise run typecheck:script` checks, and it has held real credentials.
# `templates/main.example.ts` seeds it on first run.
scripts/main.ts
# MCP browser-session detritus: page snapshots of the running UI, so they capture
# whatever the editor had open, device address included.
.playwright-mcp/
node_modules/
dist/
.tsc-out/
# Fixture workspaces for the gate/e2e device builds (scripts/fixture-workspace.mjs)
.tmp/
web/dist/
# Anchored: the build output is the repo-root site/ only. A bare `site/` would
# also swallow web/site/, the presentation page *sources* (M26).
/site/
.shellint/
.devroom/
.txiki/
# Vendored txiki.js binaries (see the Runtime row in CLAUDE.md) — multi-MB
# prebuilt executables, fetched from a release, never committed.
/vendor/
test-results/
playwright-report/
blob-report/
e2e/.cache/
.tools/
