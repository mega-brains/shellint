{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"],
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": false
  },
  "include": ["server/**/*.ts"],
  "exclude": [
    "server/index.txiki.ts",
    "server/runtime/txiki.ts",
    "server/build/txiki-runtime.ts"
  ]
}
