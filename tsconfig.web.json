{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "allowImportingTsExtensions": false,
    "jsx": "react-jsx",
    "jsxImportSource": "preact"
  },
  "include": ["web/**/*.ts", "web/**/*.tsx"]
}
