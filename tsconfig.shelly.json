{
  "compilerOptions": {
    "target": "ES5",
    "module": "None",
    "strict": true,
    "noEmitHelpers": true,
    "importHelpers": false,
    "downlevelIteration": false,
    "useDefineForClassFields": false,
    "isolatedModules": false,
    "skipLibCheck": true,
    // No lib.es*.d.ts at all: types/espruino-lib.d.ts is the whole standard library,
    // so Promise/Set/Symbol/RegExp/[].map are type errors rather than runtime crashes.
    "noLib": true,
    // Device code must not see @types/node either — it is auto-included otherwise,
    // and it references lib.es2015…es2020, which re-declares what noLib removed.
    "types": [],
    "removeComments": false,
    "rootDir": "./scripts",
    "outDir": "./.tsc-out"
  },
  "include": ["scripts/main.ts", "types/**/*.d.ts"]
}
