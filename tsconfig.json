{
  // IDE-only aid: WebStorm defaults to the root tsconfig.json for JSX/module
  // resolution when no other config wins. Build scripts always pass an
  // explicit -p (tsconfig.shelly.json / .server.json / .web.json); this file
  // does not participate in the build.
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "jsxImportSource": "preact"
  },
  "include": ["web/**/*.ts", "web/**/*.tsx"]
}
