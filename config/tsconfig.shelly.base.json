{
  // Device compiler options only — no entry point. Three configs extend it:
  //   config/tsconfig.shelly.script.json   the user's live scripts/main.ts
  //   config/tsconfig.shelly.fixture.json  fixtures/device/main.ts (the gate's entry)
  //   .tsc-out/tsconfig.json        generated by scripts/build-shelly.mjs when
  //                                 SHELLINT_SCRIPT points at fixture workspace
  // No entry list of its own: each child config supplies `include`.
  "include": [],
  "compilerOptions": {
    "target": "ES5",
    "module": "None",
    "strict": true,
    "noEmitHelpers": true,
    "importHelpers": false,
    "downlevelIteration": false,
    "useDefineForClassFields": false,
    "isolatedModules": false,
    "skipLibCheck": true,
    // No lib.es*.d.ts at all: types/espruino-lib.d.ts is the whole standard library,
    // so Promise/Set/Symbol/RegExp/[].map are type errors rather than runtime crashes.
    "noLib": true,
    // Device code must not see @types/node either — it is auto-included otherwise,
    // and it references lib.es2015…es2020, which re-declares what noLib removed.
    "types": [],
    "removeComments": false,
    "outDir": "../.tsc-out"
  },
  // types/generated.d.ts is probe output from one device on one firmware. It is
  // advisory — the lint pass reports what the probe found absent — and must not
  // decide whether a build compiles.
  "exclude": ["../types/generated.d.ts"]
}
